class TestFlagService:
    """Test FlagService functionality."""

    @pytest.mark.asyncio
    async def test_set_flag(self):
        """Test setting a narrative flag."""
        async with get_session() as session:

        service = FlagService(session)

        flag = await service.set_flag(
            user_id=12345,
            flag_key="met_diana",
            flag_value="true"
        )

        assert flag.user_id == 12345
        assert flag.flag_key == "met_diana"
        assert flag.flag_value == "true"
        assert flag.expires_at is None

    @pytest.mark.asyncio
    async def test_get_flag(self):
        """Test retrieving a narrative flag."""
        async with get_session() as session:

        service = FlagService(session)

        # Set a flag first
        await service.set_flag(user_id=12345, flag_key="test_flag")

        # Retrieve it
        flag = await service.get_flag(user_id=12345, flag_key="test_flag")

        assert flag is not None
        assert flag.flag_key == "test_flag"

    @pytest.mark.asyncio
    async def test_has_flag(self):
        """Test checking if user has a flag."""
        async with get_session() as session:

        service = FlagService(session)

        # Before setting
        has_before = await service.has_flag(user_id=12345, flag_key="test_flag")
        assert has_before is False

        # After setting
        await service.set_flag(user_id=12345, flag_key="test_flag")
        has_after = await service.has_flag(user_id=12345, flag_key="test_flag")
        assert has_after is True

    @pytest.mark.asyncio
    async def test_clear_flag(self):
        """Test clearing a narrative flag."""
        async with get_session() as session:

        service = FlagService(session)

        # Set a flag
        await service.set_flag(user_id=12345, flag_key="test_flag")

        # Clear it
        cleared = await service.clear_flag(user_id=12345, flag_key="test_flag")
        assert cleared is True

        # Verify it's gone
        flag = await service.get_flag(user_id=12345, flag_key="test_flag")
        assert flag is None

    @pytest.mark.asyncio
    async def test_expired_flag_auto_cleanup(self):
        """Test that expired flags are automatically cleaned up."""
        async with get_session() as session:

        service = FlagService(session)

        # Set an expired flag
        await service.set_flag(
            user_id=12345,
            flag_key="expired_flag",
            expires_at=datetime.now(timezone.utc) - timedelta(hours=1)
        )

        # Try to get it - should be cleaned up
        flag = await service.get_flag(user_id=12345, flag_key="expired_flag")
        assert flag is None


class TestArchetypeService:
    """Test ArchetypeService functionality."""

    @pytest.mark.asyncio
    async def test_get_or_create_archetype_profile(self):
        """Test getting or creating archetype profile."""
        async with get_session() as session:

        service = ArchetypeService(session)

        # First call creates profile
        profile1 = await service.get_or_create_archetype_profile(user_id=12345)
        assert profile1.primary_archetype == "EXPLORER"
        assert profile1.archetype_confidence == 30

        # Second call returns existing profile
        profile2 = await service.get_or_create_archetype_profile(user_id=12345)
        assert profile1.id == profile2.id

    @pytest.mark.asyncio
    async def test_add_archetype_points(self):
        """Test adding archetype points."""
        async with get_session() as session:

        service = ArchetypeService(session)

        # Create profile
        profile = await service.get_or_create_archetype_profile(user_id=12345)

        # Add points
        await service.add_archetype_points(
            user_id=12345,
            points_dict={"romantic": +5, "direct": -2}
        )

        # Verify points updated
        await session.refresh(profile)
        assert profile.archetype_points["romantic"] == 5
        assert profile.archetype_points["direct"] == -2

    @pytest.mark.asyncio
    async def test_record_choice_timing(self):
        """Test recording choice timing for archetype detection."""
        async with get_session() as session:

        service = ArchetypeService(session)

        # Record fast choice
        await service.record_choice_timing(user_id=12345, choice_time_seconds=5)

        # Record slow choice
        await service.record_choice_timing(user_id=12345, choice_time_seconds=35)

        # Verify stats
        profile = await service.get_or_create_archetype_profile(user_id=12345)
        assert profile.total_choices_analyzed == 2
        assert profile.average_choice_time_seconds == 20  # (5 + 35) / 2


class TestCharacterRelationshipService:
    """Test CharacterRelationshipService functionality."""

    @pytest.mark.asyncio
    async def test_get_relationship(self):
        """Test getting a character relationship."""
        async with get_session() as session:

        service = CharacterRelationshipService(session)

        # Before creating
        relationship = await service.get_relationship(user_id=12345, character_name="LUCIEN")
        assert relationship is None

    @pytest.mark.asyncio
    async def test_get_or_create_relationship(self):
        """Test getting or creating a relationship."""
        async with get_session() as session:

        service = CharacterRelationshipService(session)

        # First call creates
        rel1 = await service.get_or_create_relationship(user_id=12345, character_name="LUCIEN")
        assert rel1.relationship_score == 0

        # Second call returns existing
        rel2 = await service.get_or_create_relationship(user_id=12345, character_name="LUCIEN")
        assert rel1.id == rel2.id

    @pytest.mark.asyncio
    async def test_update_relationship_score(self):
        """Test updating relationship score."""
        async with get_session() as session:

        service = CharacterRelationshipService(session)

        # Create relationship
        rel = await service.get_or_create_relationship(user_id=12345, character_name="DIANA")

        # Update score
        updated = await service.update_relationship_score(
            user_id=12345,
            character_name="DIANA",
            score_change=+50
        )

        assert updated.relationship_score == 50
        assert updated.interaction_count == 2

    @pytest.mark.asyncio
    async def test_relationship_score_bounds(self):
        """Test that relationship score is bounded between -100 and +100."""
        async with get_session() as session:

        service = CharacterRelationshipService(session)

        # Create relationship
        rel = await service.get_or_create_relationship(user_id=12345, character_name="LUCIEN")

        # Try to exceed upper bound
        updated1 = await service.update_relationship_score(user_id=12345, character_name="LUCIEN", score_change=+200)
        assert updated1.relationship_score == 100  # Capped at 100

        # Try to exceed lower bound
        updated2 = await service.update_relationship_score(user_id=12345, character_name="LUCIEN", score_change=-250)
        assert updated2.relationship_score == -100  # Capped at -100


class TestNarrativeService:
    """Test NarrativeService functionality."""

    @pytest.mark.asyncio
    async def test_get_starting_fragment(self, session, mock_bot):
        """Test getting starting fragment for a level."""
        service = NarrativeService(session, mock_bot)

        # Create starting fragment
        fragment = StoryFragment(
            fragment_id="L1_START",
            narrative_level=1,
            title="Level 1 Start",
            is_starting_fragment=True,
            active=True
        )
        session.add(fragment)
        await session.commit()

        # Get it
        retrieved = await service.get_starting_fragment(narrative_level=1)
        assert retrieved is not None
        assert retrieved.fragment_id == "L1_START"

    @pytest.mark.asyncio
    async def test_get_fragment(self, session, mock_bot):
        """Test getting fragment by ID."""
        service = NarrativeService(session, mock_bot)

        # Create fragment
        fragment = StoryFragment(
            fragment_id="L1_TEST",
            narrative_level=1,
            title="Test Fragment",
            active=True
        )
        session.add(fragment)
        await session.commit()

        # Get it
        retrieved = await service.get_fragment(fragment_id="L1_TEST")
        assert retrieved is not None
        assert retrieved.title == "Test Fragment"

    @pytest.mark.asyncio
    async def test_get_or_create_user_progress(self, session, mock_bot):
        """Test getting or creating user progress."""
        service = NarrativeService(session, mock_bot)

        # Create starting fragment first
        fragment = StoryFragment(
            fragment_id="L1_START",
            narrative_level=1,
            title="Start",
            is_starting_fragment=True,
            active=True
        )
        session.add(fragment)
        await session.commit()

        # Create user progress
        progress = await service.get_or_create_user_progress(user_id=12345)
        assert progress.user_id == 12345
        assert progress.current_narrative_level == 1

    @pytest.mark.asyncio
    async def test_advance_to_next_fragment(self, session, mock_bot):
        """Test advancing to next fragment via choice."""
        service = NarrativeService(session, mock_bot)

        # Create fragments
        fragment1 = StoryFragment(
            fragment_id="L1_F1",
            narrative_level=1,
            title="Fragment 1",
            active=True
        )
        session.add(fragment1)
        await session.flush()

        fragment2 = StoryFragment(
            fragment_id="L1_F2",
            narrative_level=1,
            title="Fragment 2",
            active=True
        )
        session.add(fragment2)
        await session.flush()

        # Create choice
        choice = StoryChoice(
            choice_id="L1_F1_A",
            fragment_id=fragment1.id,
            choice_text="Continue",
            target_fragment_id=fragment2.id,
            consequences={
                "flags_set": ["test_flag"],
                "archetype_points": {"romantic": 2}
            }
        )
        session.add(choice)
        await session.commit()

        # Advance
        success, message, next_fragment, consequences = await service.advance_to_next_fragment(
            user_id=12345,
            choice_id="L1_F1_A"
        )

        assert success is True
        assert next_fragment.fragment_id == "L1_F2"
        assert consequences["flags_set"] == ["test_flag"]


class TestStoryEngine:
    """Test StoryEngine coordination."""

    @pytest.mark.asyncio
    async def test_get_current_story_state(self, session, mock_bot):
        """Test getting complete story state."""
        engine = StoryEngine(session, mock_bot)

        # Create starting fragment
        fragment = StoryFragment(
            fragment_id="L1_START",
            narrative_level=1,
            title="Start",
            is_starting_fragment=True,
            active=True
        )
        session.add(fragment)
        await session.commit()

        # Get state
        state = await engine.get_current_story_state(user_id=12345)

        assert "current_fragment" in state
        assert "user_progress" in state
        assert "archetype" in state
        assert state["can_continue"] is True

    @pytest.mark.asyncio
    async def test_make_choice(self, session, mock_bot):
        """Test making a choice through the engine."""
        engine = StoryEngine(session, mock_bot)

        # Setup fragments and choice
        f1 = StoryFragment(
            fragment_id="L1_F1",
            narrative_level=1,
            title="F1",
            active=True
        )
        session.add(f1)
        await session.flush()

        f2 = StoryFragment(
            fragment_id="L1_F2",
            narrative_level=1,
            title="F2",
            active=True
        )
        session.add(f2)
        await session.flush()

        choice = StoryChoice(
            choice_id="L1_F1_A",
            fragment_id=f1.id,
            choice_text="Go",
            target_fragment_id=f2.id
        )
        session.add(choice)
        await session.commit()

        # Make choice
        result = await engine.make_choice(
            user_id=12345,
            choice_id="L1_F1_A",
            choice_time_seconds=15
        )

        assert result["success"] is True
        assert "next_fragment" in result
        assert result["next_fragment"].fragment_id == "L1_F2"


